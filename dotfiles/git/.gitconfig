[user]
    name = {{ git_user_name }}
    email = {{ git_user_email }}
    useConfigOnly = true

[init]
    defaultBranch = main

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true

[fetch]
    prune = true

[push]
    autoSetupRemote = true

[merge]
    conflictStyle = zdiff3

[credential "https://github.com"]
    helper =
    helper = {{ ("!" ~ ((workstation_home ~ "/.local/share/mise/shims/gh") | quote) ~ " auth git-credential") | to_json(ensure_ascii=False) }}

[credential "https://gist.github.com"]
    helper =
    helper = {{ ("!" ~ ((workstation_home ~ "/.local/share/mise/shims/gh") | quote) ~ " auth git-credential") | to_json(ensure_ascii=False) }}
